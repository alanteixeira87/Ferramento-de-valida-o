{
  "manifest_version": 3,
  "name": "QA Analytics - Correlação SIGC",
  "version": "1.1.1",
  "description": "Correlaciona os testes do validador de logs FVP com a plataforma SIGC Retestes e traz os logs do FVP usando as sessões já logadas do navegador.",
  "permissions": ["tabs", "debugger", "scripting"],
  "host_permissions": [
    "https://www.sigc.com.br/*",
    "https://sigc.com.br/*",
    "https://web.fvp.directory.openbankingbrasil.org.br/*",
    "https://*.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sigc.com.br/*", "https://sigc.com.br/*"],
      "js": ["sigc-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.github.io/*"
      ],
      "js": ["validator-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
